<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the cat icon on Lumi's dark background, then Flutter's animated splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/lumi_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lumi_background</item>
    </style>
</resources>