<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to the phone itself, which `adb reverse` forwards to Lumi Core on the laptop.
     Everything else (the VPS) must use HTTPS. Debug builds additionally allow HTTP to a LAN address
     (usesCleartextTraffic in src/debug/AndroidManifest.xml). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
